# TiDB Cloud Starter: open your instance, click Connect, and copy these values.
# The instance must be on AWS in a region with full-text search (see README).
# Or skip this file and run `python demo.py zero` to get a disposable database.
TIDB_HOST=gateway01.<region>.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USERNAME=<prefix>.root
TIDB_PASSWORD=
TIDB_DATABASE=agent_memory_demo
